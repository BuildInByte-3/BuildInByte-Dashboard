# Dashboard server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Generate with: openssl rand -base64 32
ADMIN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
ADMIN_SESSION_PEPPER=replace-with-a-long-random-value
ADMIN_RECOVERY_PEPPER=replace-with-a-different-long-random-value
IP_HASH_SALT=replace-with-a-long-random-value

NEXT_PUBLIC_DASHBOARD_NAME=BuildInByte Admin
NEXT_PUBLIC_WEBSITE_URL=https://buildinbyte.in

# Optional local-only preview. It is forcibly ignored in Vercel production.
# Store an Argon2id hash here, never a plaintext password.
DASHBOARD_PREVIEW_MODE=false
DASHBOARD_PREVIEW_EMAIL=preview@example.test
DASHBOARD_PREVIEW_PASSWORD_HASH=\$argon2id\$replace-with-generated-hash
DASHBOARD_PREVIEW_SESSION_SECRET=replace-with-at-least-32-random-characters
